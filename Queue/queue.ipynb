   "source": [
    "# implementation queue using list\n",
    "\n",
    "q = []\n",
    "\n",
    "q.append(10)\n",
    "q.append(20)\n",
    "q.append(30)\n",
    "\n",
    "q\n",
    "\n",
    "q.pop()\n",
    "\n",
    "q\n"
