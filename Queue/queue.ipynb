   "source": [
    "# using collection.dequq\n",
    "\n",
    "from collections import deque\n",
    "\n",
    "q = deque()\n",
    "\n",
    "q.append(10)\n",
    "q.append(20)\n",
    "q.append(30)\n",
    "\n",
    "print(q.popleft())\n",
    "\n",
    "q\n"
   ]
